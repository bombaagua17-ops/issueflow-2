<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}IssueFlow{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <style>
        .badge { padding: .15rem .6rem; border-radius: 999px; font-size: .8rem; color: #fff; }
        .badge-urgent { background: #d32f2f; }
        .badge-high { background: #ef6c00; }
        .badge-normal { background: #607d8b; }
    </style>
</head>
<body>
    <header class="container">
        <nav>
            <ul><li><strong>IssueFlow</strong></li></ul>
            <ul>
                <li><a href="{{ path('app_home') }}">Inicio</a></li>
                <li><a href="{{ path('app_ticket_index') }}">Incidencias</a></li>
                <li><a href="{{ path('app_health') }}">Estado</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block body %}{% endblock %}
    </main>

    <footer class="container">
        <small>IssueFlow &middot; Proyecto de práctica con Symfony</small>
    </footer>
</body>
</html>